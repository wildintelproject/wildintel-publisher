{# Renderizada por write_citation() en services/common.py. Los fallbacks
   (cff_version, message, citation_type, date_released) se resuelven en
   Python antes de llegar aquí, así que siempre llegan ya definidos.
   Cada author/contact es "person" (given_names/family_names/affiliation,
   desde HFHSettings) o "entity" (solo name/affiliation, desde los
   contributors de datapackage.json — Trapper solo da el nombre completo,
   sin separar en nombre/apellidos). contact (Camtrap DP only, ver
   common.resolve_contact) son los contributors con role="contact" —
   deliberadamente NO están también en authors (ver common.resolve_authors),
   y se omite el bloque entero si no hay ninguno (a diferencia de authors,
   contact es opcional en CITATION.cff).

   preferred_citation (Camtrap DP only, ver common.resolve_publisher/
   resolve_copyright_holders — armado en write_citation) lleva los
   contributors con role="publisher"/"rightsHolder": CITATION.cff no tiene
   ningún campo "publisher"/"copyright" a nivel raíz (solo existen dentro
   de un objeto "reference" — verificado contra el schema oficial), así
   que se repiten title/authors/type/version/date-released dentro de un
   bloque preferred-citation, que sí acepta ambos. None si no hay ni
   publisher ni copyright_holders.

   url/doi/identifiers/notes: write_citation() solo se llama una vez, al
   preparar el export — antes de que se conozca el repo/DOI/PID de
   destino —, así que aquí siempre llegan a None/[] y estos bloques no se
   disparan nunca en ese primer render. Se documentan igualmente para que
   quede claro qué puede acabar apareciendo: una vez el destino se conoce
   de verdad, hfh.py's _patch_citation_with_repo_id / zenodo.py's
   _patch_citation_with_doi / b2share.py's _patch_citation_with_pid
   añaden esas claves directamente al YAML ya escrito (yaml.safe_load +
   safe_dump), sin volver a pasar por esta plantilla. Nunca se usa
   "repository-artifact". #}
{% macro person_or_entity(item, indent) %}
{% if item.given_names is defined %}
{{ indent }}- given-names: {{ item.given_names | tojson }}
{{ indent }}  family-names: {{ item.family_names | tojson }}
{{ indent }}  affiliation: {{ item.affiliation | tojson }}
{% else %}
{{ indent }}- name: {{ item.name | tojson }}
{% if item.affiliation %}
{{ indent }}  affiliation: {{ item.affiliation | tojson }}
{% endif %}
{% endif %}
{% endmacro %}
cff-version: {{ cff_version | tojson }}
title: {{ title | tojson }}
message: {{ message | tojson }}
type: {{ citation_type | tojson }}
authors:
{% for author in authors %}
{{ person_or_entity(author, '  ') }}
{% endfor %}
{% if contact %}
contact:
{% for person in contact %}
{{ person_or_entity(person, '  ') }}
{% endfor %}
{% endif %}
version: {{ version | tojson }}
date-released: {{ date_released | tojson }}
license: {{ license_id | tojson }}
{% if repository_code %}
repository-code: {{ repository_code | tojson }}
{% endif %}
{% if url %}
url: {{ url | tojson }}
{% endif %}
{% if doi %}
doi: {{ doi | tojson }}
{% endif %}
{% if identifiers %}
identifiers:
{% for identifier in identifiers %}
  - type: {{ identifier.type | tojson }}
    value: {{ identifier.value | tojson }}
    description: {{ identifier.description | tojson }}
{% endfor %}
{% endif %}
{% if notes %}
notes: {{ notes | tojson }}
{% endif %}
{% if preferred_citation %}
preferred-citation:
  type: {{ preferred_citation.type | tojson }}
  title: {{ preferred_citation.title | tojson }}
  authors:
{% for author in preferred_citation.authors %}
{{ person_or_entity(author, '    ') }}
{% endfor %}
  version: {{ preferred_citation.version | tojson }}
  date-released: {{ preferred_citation.date_released | tojson }}
{% if preferred_citation.publisher %}
  publisher:
    name: {{ preferred_citation.publisher.name | tojson }}
{% if preferred_citation.publisher.website %}
    website: {{ preferred_citation.publisher.website | tojson }}
{% endif %}
{% if preferred_citation.publisher.email %}
    email: {{ preferred_citation.publisher.email | tojson }}
{% endif %}
{% endif %}
{% if preferred_citation.copyright %}
  copyright: {{ preferred_citation.copyright | tojson }}
{% endif %}
{% endif %}
